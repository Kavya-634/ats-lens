# Optional: enables the "Improve with AI" button in the editor.
# Set ONE of these in Vercel -> Project -> Settings -> Environment Variables
# (or in a local .env file when running `vercel dev`). Never commit real keys.
# Without a key the whole app works; only the AI button is hidden.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional model override (defaults: claude-haiku-5-5 / gpt-5.4-mini)
# AI_MODEL=
